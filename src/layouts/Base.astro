---
import '../styles/global.css';
import { site, address, contact, pending, hours, universes, rating } from '../data/site';
import { openingHoursSpecification } from '../lib/hours';
import Header from '../components/Header.astro';
import Dock from '../components/Dock.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/* Fiche établissement pour Google : c'est elle qui alimente la recherche
   locale (« prothésiste ongulaire près de moi ») et le panneau de droite.
   On n'émet que les champs réellement renseignés. */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: site.name,
  description: site.description,
  url: site.url,
  image: new URL('/og.jpg', site.url).href,
  openingHoursSpecification: openingHoursSpecification(),
  makesOffer: universes.flatMap((u) =>
    u.categories.flatMap((c) =>
      c.items.map((s) => ({
        '@type': 'Offer',
        price: s.price,
        priceCurrency: 'EUR',
        itemOffered: { '@type': 'Service', name: s.name, category: u.label },
      })),
    ),
  ),
  aggregateRating: rating.show
    ? { '@type': 'AggregateRating', ratingValue: rating.value, reviewCount: rating.count }
    : undefined,
};
if (address.street && address.city && address.postalCode) {
  jsonLd.address = {
    '@type': 'PostalAddress',
    streetAddress: `${address.streetNumber} ${address.street}`,
    postalCode: address.postalCode,
    addressLocality: address.city,
    addressCountry: address.country,
  };
}
if (contact.phone) jsonLd.telephone = contact.phone;
if (contact.email) jsonLd.email = contact.email;
if (contact.instagram) jsonLd.sameAs = [contact.instagram];

const showBanner = pending.length > 0;
---

<!doctype html>
<html lang="fr" class={showBanner ? 'has-banner' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#191A1E" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@400;500;600&family=Pinyon+Script&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  </head>

  <body>
    {
      showBanner && (
        <div class="preview">
          <span class="wide-only">
            Aperçu — {pending.slice(0, 3).join(', ')}
            {pending.length > 3 ? ' et autres données' : ''} à compléter.
          </span>
          <span class="narrow-only">Aperçu — {pending.length} données à compléter</span>
        </div>
      )
    }

    <Header />
    <span id="haut" class="sr-only" />
    <main>
      <slot />
    </main>
    <Dock />

    <script>
      /* En-tête opaque dès qu'on quitte le hero. */
      const top = document.getElementById('top');
      const hero = document.querySelector('.hero');
      if (top && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([e]) => top.classList.toggle('solid', !e.isIntersecting),
          { rootMargin: '-88% 0px 0px 0px' },
        ).observe(hero);
      } else {
        top?.classList.add('solid');
      }
    </script>

    <script is:inline define:vars={{ hours }}>
      /* Ouvert / fermé — calculé chez le visiteur, sur l'heure de Paris.
         Le site étant statique, un calcul au build serait figé. */
      (function () {
        var GRID = {};
        hours.forEach(function (d) {
          GRID[d.day] = d.open === null ? null : [d.open, d.close];
        });
        var NAMES = {
          0: 'dimanche', 1: 'lundi', 2: 'mardi', 3: 'mercredi',
          4: 'jeudi', 5: 'vendredi', 6: 'samedi',
        };

        function paris() {
          var parts = new Intl.DateTimeFormat('fr-FR', {
            timeZone: 'Europe/Paris', weekday: 'short',
            hour: '2-digit', minute: '2-digit', hour12: false,
          }).formatToParts(new Date());
          var g = {};
          parts.forEach(function (p) { g[p.type] = p.value; });
          var map = { dim: 0, lun: 1, mar: 2, mer: 3, jeu: 4, ven: 5, sam: 6 };
          var key = (g.weekday || '').toLowerCase().slice(0, 3).replace('.', '');
          return {
            day: map[key] != null ? map[key] : new Date().getDay(),
            mins: parseInt(g.hour, 10) * 60 + parseInt(g.minute, 10),
          };
        }
        function hhmm(m) {
          return Math.floor(m / 60) + ' h ' + String(m % 60).padStart(2, '0');
        }

        var now = paris();
        var today = GRID[now.day];
        var open = !!today && now.mins >= today[0] && now.mins < today[1];

        var li = document.querySelector('#hours li[data-d="' + now.day + '"]');
        if (li) li.classList.add('today');

        var next = '';
        if (open) {
          next = 'Fermeture à ' + hhmm(today[1]);
        } else {
          for (var i = 0; i < 8; i++) {
            var d = (now.day + i) % 7;
            var g = GRID[d];
            if (!g) continue;
            if (i === 0 && now.mins >= g[0]) continue;
            next = i === 0 ? 'Ouverture à ' + hhmm(g[0])
                 : i === 1 ? 'Ouvre demain à ' + hhmm(g[0])
                 : 'Ouvre ' + NAMES[d] + ' à ' + hhmm(g[0]);
            break;
          }
        }

        function set(id, txt) {
          var el = document.getElementById(id);
          if (el) el.textContent = txt;
        }
        var live = document.getElementById('live');
        if (live) live.setAttribute('data-open', String(open));
        set('live-txt', open ? 'Ouvert' : 'Fermé');
        set('live-next', next);
        set('st-big', open ? 'C’est ouvert.' : 'C’est fermé.');
        set('st-next', next + '.');
        set('dock-txt', (open ? 'Ouvert · ' : 'Fermé · ') + next);
      })();
    </script>
  </body>
</html>
