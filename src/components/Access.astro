---
import { Image } from 'astro:assets';
import { address, contact, practitioners, about } from '../data/site';
import Todo from './Todo.astro';
import facade from '../assets/salon-facade.jpg';
---
<section id="acces">
  <div class="shell">
    <div class="access">
      <Image
        src={facade}
        widths={[420, 760, 1100]}
        sizes="(max-width: 860px) 100vw, 45vw"
        format="avif"
        quality={70}
        loading="lazy"
        alt="Façade de l'institut Lily's Beauty vue depuis la rue"
      />
      <div>
        <hr class="rule" />
        <p class="addr">{about.lead}</p>
        {about.body.map((t) => <p class="about-p">{t}</p>)}
        <dl>
          <div>
            <dt>Adresse</dt>
            <dd>
              {address.street && address.postalCode && address.city ? (
                <>
                  {address.streetNumber}, {address.street}<br />{address.postalCode} {address.city}
                  {address.mapsUrl && (
                    <><br /><a href={address.mapsUrl} target="_blank" rel="noopener"
                        style="color:var(--rose-ink)">Ouvrir dans Google Maps</a></>
                  )}
                </>
              ) : (
                <>{address.streetNumber}, <Todo label="rue à compléter" /><br />
                  <Todo label="Code postal et ville" /></>
              )}
            </dd>
          </div>
          {contact.phone && (
            <div>
              <dt>Téléphone</dt>
              <dd><a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></dd>
            </div>
          )}
          {practitioners.some((p) => p.instagram) && (
            <div>
              <dt>Instagram</dt>
              <dd class="insta">
                {practitioners.filter((p) => p.instagram).map((p) => (
                  <a href={p.instagram!} target="_blank" rel="noopener">{p.name}</a>
                ))}
              </dd>
            </div>
          )}
          {address.directions && (
            <div><dt>Accès</dt><dd>{address.directions}</dd></div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>
