---
import { universes, practitioners } from '../data/site';
const numerals = ['i', 'ii', 'iii'];
---
<section id="prestations">
  <div class="shell">
    <div class="duo">
      <div>
        <hr class="rule" />
        <p class="duo-lead">
          Un institut de village tenu par <em>deux praticiennes</em>, chacune sur sa spécialité.
        </p>
        <p class="duo-body">
          Fiacrine s'occupe des ongles. Juliette des cils, des sourcils et de l'épilation.
          Chaque prestation est réservée pour sa durée réelle — dix minutes pour un menton,
          près de deux heures pour une pose complète — pour que personne ne soit expédié.
        </p>
        <ul class="who">
          {practitioners.map((p) => (
            <li><b>{p.name}</b><span>{p.craft}</span></li>
          ))}
        </ul>
      </div>
      <div class="crafts">
        {universes.map((u, i) => (
          <article class="craft">
            <span class="n" aria-hidden="true">{numerals[i]}</span>
            <div>
              <h3>{u.label}</h3>
              <p>{u.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
