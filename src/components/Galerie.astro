---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { galerie, galerieIntro } from '../data/site';

const fichiers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/salon-*.jpg',
  { eager: true },
);

const photos = galerie.map((p) => {
  const trouve = fichiers[`../assets/${p.fichier}`];
  if (!trouve) throw new Error(`galerie : src/assets/${p.fichier} est introuvable`);
  return { src: trouve.default, alt: p.alt };
});

/* Le ruban défile sans fin : il faut donc plus de photos que l'écran n'en
   montre. Un tour avance d'une série ; ce qui reste derrière, soit
   (SERIES - 1) séries, doit encore couvrir la fenêtre. Avec quatre, cela
   fait 3 680 px de marge : large pour n'importe quel écran.

   Le décalage de l'animation est calculé depuis ce nombre, pas écrit à
   côté : changer SERIES ne peut donc pas désaccorder les deux et faire
   sauter le raccord à chaque tour.

   Seule la première série est lue par les lecteurs d'écran ; les autres
   sont du décor et le disent. */
const SERIES = 4;
---

<section id="salon">
  <div class="shell">
    <div class="sec-top monte">
      <hr class="rule" />
      <h2>{galerieIntro.titre}</h2>
      <p>{galerieIntro.lead}</p>
    </div>
  </div>

  <div class="ruban monte" data-ruban>
    <div class="ruban-piste" style={`--series: ${SERIES}`}>
      {Array.from({ length: SERIES }).map((_, serie) => (
        <ul class="ruban-serie" aria-hidden={serie > 0 ? 'true' : undefined}>
          {photos.map((p) => (
            <li>
              <Image
                src={p.src}
                alt={serie === 0 ? p.alt : ''}
                widths={[240, 480, 640]}
                sizes="(max-width: 700px) 56vw, (max-width: 1100px) 30vw, 22vw"
                format="avif"
                quality={62}
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <div class="shell ruban-cmd">
    <button type="button" data-ruban-pause aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="i-pause">
        <path d="M9 5v14M15 5v14" />
      </svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="i-play">
        <path d="M8 5l11 7-11 7z" />
      </svg>
      <span data-ruban-mot>Arrêter le défilement</span>
    </button>
  </div>
</section>

<script is:inline>
  /* Le ruban défile en CSS seul. Ce script ne sert qu'au bouton.

     Arrêter ne fige pas seulement l'animation : ça rend aussi le ruban
     **défilable à la main**. Sans quoi mettre en pause enfermerait les
     photos hors écran, qu'aucun geste ne pourrait plus atteindre. Même
     raison pour le mouvement réduit, traité en CSS : là le ruban est une
     bande qu'on fait défiler soi-même, du premier au dernier cliché. */
  (function () {
    var ruban = document.querySelector('[data-ruban]');
    var bouton = document.querySelector('[data-ruban-pause]');
    if (!ruban || !bouton) return;

    var mot = bouton.querySelector('[data-ruban-mot]');
    var doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!doux) {
      /* Le CSS a déjà transformé le ruban en bande défilable ; le bouton
         n'aurait rien à arrêter. */
      bouton.hidden = true;
      return;
    }

    function etat(arrete) {
      ruban.classList.toggle('arrete', arrete);
      bouton.setAttribute('aria-pressed', arrete ? 'true' : 'false');
      mot.textContent = arrete ? 'Relancer le défilement' : 'Arrêter le défilement';
    }

    bouton.addEventListener('click', function () {
      etat(!ruban.classList.contains('arrete'));
    });

    /* Survol et focus suspendent sans toucher au bouton : on regarde,
       puis ça repart. Le bouton, lui, décide pour de bon. */
    ruban.addEventListener('pointerenter', function () {
      if (!ruban.classList.contains('arrete')) ruban.classList.add('survol');
    });
    ruban.addEventListener('pointerleave', function () {
      ruban.classList.remove('survol');
    });
    ruban.addEventListener('focusin', function () {
      ruban.classList.add('survol');
    });
    ruban.addEventListener('focusout', function () {
      ruban.classList.remove('survol');
    });
  })();
</script>
