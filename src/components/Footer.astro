---
import { Image } from 'astro:assets';
import { site, pending, sections } from '../data/site';
import logo from '../assets/logo.png';
const year = new Date().getFullYear();
---
<footer>
  <div class="shell">
    <div class="foot">
      <Image
        class="foot-logo monte"
        src={logo}
        alt={`${site.name}, ${site.tagline}`}
        widths={[300, 600]}
        sizes="300px"
        loading="lazy"
      />
      <nav class="foot-links" aria-label="Navigation de pied de page">
        {sections.map((s) => <a href={'/' + s.href}>{s.label}</a>)}
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
      <p class="foot-note">
        © {year} {site.name}.
        {pending.length > 0 && (
          <> Site en cours de finalisation : {pending.join(', ')} restent à compléter.
            Tout est regroupé dans <code>src/data/site.ts</code>.</>
        )}
      </p>
    </div>
  </div>
</footer>
