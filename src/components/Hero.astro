---
import { getImage } from 'astro:assets';
import { address, rating } from '../data/site';
import BookButton from './BookButton.astro';
import Todo from './Todo.astro';
import facade from '../assets/salon-facade.jpg';
import attente from '../assets/salon-attente-portrait.jpg';

/* Direction artistique : deux photos, pas deux cadrages. L'ordinateur
   reçoit la devanture en bande large ; le téléphone reçoit l'intérieur,
   le coin d'attente et son canapé — demande du salon. AVIF puis WebP,
   JPEG en dernier recours ; le repli JPEG prend la devanture, puisqu'un
   navigateur qui l'atteint ignore aussi `media`. */
const wideAvif = await getImage({ src: facade, format: 'avif', quality: 60 });
const wideWebp = await getImage({ src: facade, format: 'webp', quality: 72 });
/* Le portrait est servi en trois largeurs : c'est le plus gros fichier
   de la page et il tombe sur des téléphones, où la densité d'écran va du
   simple au triple. Sans cela, un écran à deux pixels par point
   téléchargeait le fichier des écrans à trois. */
const TAILLES = [420, 800, 1200];
const tallAvif = await getImage({ src: attente, format: 'avif', quality: 60, widths: TAILLES });
const tallWebp = await getImage({ src: attente, format: 'webp', quality: 72, widths: TAILLES });
const fallback = await getImage({ src: facade, format: 'jpeg', quality: 78 });
---
<div class="hero">
  {/* Texte de remplacement vide, et c'est voulu : l'attribut `alt` est
      unique alors que la photo, elle, change avec la largeur d'écran — il
      décrirait une devanture aux uns et un intérieur aux autres. Les deux
      photos sont décrites là où elles portent une information : la
      devanture dans la section « Accès », le coin d'attente dans le ruban.
      Ici elles ne font que planter le décor. */}
  <picture>
    <source
      media="(max-width: 700px)"
      type="image/avif"
      sizes="100vw"
      srcset={tallAvif.srcSet.attribute}
    />
    <source
      media="(max-width: 700px)"
      type="image/webp"
      sizes="100vw"
      srcset={tallWebp.srcSet.attribute}
    />
    <source type="image/avif" srcset={wideAvif.src} />
    <source type="image/webp" srcset={wideWebp.src} />
    <img
      src={fallback.src}
      width={fallback.attributes.width}
      height={fallback.attributes.height}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="shell hero-in">
    <span class="eyebrow">Institut de beauté · {address.city}</span>
    <h1>Ongles, <em>beauté du visage</em> et épilation</h1>
    <p class="hero-line">
      Prothésie ongulaire, extensions et rehaussement de cils, teinture des sourcils,
      épilation à la cire ou au fil. Deux sœurs, chacune sur sa spécialité.
    </p>
    <div class="hero-act">
      <BookButton />
      <a class="btn btn-ghost" href="#tarifs">Voir les tarifs</a>
    </div>
    <p class="hero-meta">
      <span class="live" id="live" data-open="false"><i></i><b id="live-txt">Horaires</b></span>
      <span id="live-next"></span>
      <span>
        <b>{address.streetNumber}</b>{' '}
        {address.street && address.city
          ? `${address.street}, ${address.city}`
          : <Todo label="rue et ville à compléter" />}
      </span>
      {rating.show && (
        <span><b>{rating.value.toLocaleString('fr-FR')}/5</b> · {rating.count} avis</span>
      )}
    </p>
  </div>
</div>
