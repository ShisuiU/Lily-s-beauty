---
import { practitioners } from '../data/site';
import InstaLink from './InstaLink.astro';
---
<div class="duo">
  <div class="monte">
    <p class="duo-lead">
      Un institut de village tenu par <em>deux sœurs</em>, chacune sur sa spécialité.
    </p>
    <p class="duo-body">
      Fiacrine s'occupe des ongles, Juliette des cils, des sourcils et de l'épilation. Chaque
      prestation est réservée pour sa durée réelle : dix minutes pour un menton, près de deux
      heures pour une pose complète. Personne n'est expédié.
    </p>
  </div>
  <ul class="who">
    {practitioners.map((p) => (
      <li class="monte">
        <b class="who-name">{p.name}</b>
        <span class="who-craft">{p.craft}</span>
        {p.instagram && <InstaLink url={p.instagram} name={p.name} />}
      </li>
    ))}
  </ul>
</div>
