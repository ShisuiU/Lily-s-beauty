---
import { site, sections } from '../data/site';
import BookButton from './BookButton.astro';
---
<header class="top" id="top">
  <div class="shell">
    <a class="brand" href="#haut">{site.name}</a>

    <nav class="nav" aria-label="Navigation principale">
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <BookButton class="hide-sm" />

    {/* Sous 880 px la navigation est masquée : ce bouton la rend accessible.
        Il reste en place quand le panneau s'ouvre et se change en croix,
        ce qui évite de dupliquer le nom du salon dans le panneau — c'était
        la cause du léger saut de taille et de position à l'ouverture. */}
    <button
      class="burger show-sm"
      id="burger"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav id="menu-mobile" class="sheet" aria-label="Sections du site" hidden>
  <ul class="sheet-nav">
    {sections.map((s, i) => (
      <li>
        <a href={s.href}>
          <i aria-hidden="true">{String(i + 1).padStart(2, '0')}</i>
          {s.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="sheet-foot">
    <span class="live" id="sheet-live" data-open="false">
      <i></i><b id="sheet-status">Horaires</b>
    </span>
    <BookButton />
  </div>
</nav>
