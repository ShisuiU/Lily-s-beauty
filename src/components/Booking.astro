---
import { planityUrl, rating } from '../data/site';
import Todo from './Todo.astro';

const steps = [
  "Choisissez la prestation — la durée et le tarif s'affichent avant de valider.",
  "Prenez un créneau réellement disponible dans l'agenda du salon.",
  'Laissez un numéro : le rappel SMS part automatiquement la veille.',
  "Un empêchement ? L'annulation se fait depuis le même lien, sans appeler.",
];
const numerals = ['i', 'ii', 'iii', 'iv'];
---
<section id="reserver">
  <div class="shell">
    <div class="book">
      <div>
        <span class="eyebrow">Rendez-vous</span>
        {rating.show && (
          <p class="rating">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span>
              <b>{rating.value.toLocaleString('fr-FR')}</b> sur 5 — {rating.count} avis
              vérifiés sur {rating.source}
            </span>
          </p>
        )}
        <h2 style="margin-top:14px">La réservation se fait sur Planity.</h2>
        <p>
          Agenda à jour en temps réel, confirmation immédiate et rappel par SMS la veille.
          Vous choisissez la prestation, elle réserve exactement la durée qu'il faut — pas de
          créneau trop court qui déborde sur la cliente suivante.
        </p>
        <div class="hero-act" style="margin-top:28px">
          {planityUrl ? (
            <a class="btn" href={planityUrl} target="_blank" rel="noopener">
              Ouvrir Planity
            </a>
          ) : (
            <span class="btn" aria-disabled="true" style="opacity:.55;cursor:not-allowed">
              Ouvrir Planity
            </span>
          )}
        </div>
        {!planityUrl && (
          <p style="margin-top:16px;font-size:.86rem">
            <Todo label="Lien Planity à renseigner dans src/data/site.ts" />
          </p>
        )}
      </div>
      <ol class="book-steps">
        {steps.map((s, i) => (
          <li><i aria-hidden="true">{numerals[i]}</i><span>{s}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>
