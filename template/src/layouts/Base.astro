---
import '../styles/global.css';
import { site, address, contact, pending, hours, universes, rating, geo, equipe, gabarit } from '../data/site';
import { openingHoursSpecification } from '../lib/hours';
import Header from '../components/Header.astro';
import Dock from '../components/Dock.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name}, ${site.tagline} à ${address.city}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/* Fiche établissement pour Google : c'est elle qui alimente la recherche
   locale (« institut de beauté près de moi ») et le panneau de droite.
   On n'émet que les champs réellement renseignés.

   `@type` décrit le métier : BeautySalon convient à un institut, un
   salon d'ongles ou un salon de coiffure ; NailSalon, HairSalon et
   DaySpa existent aussi si le métier est plus étroit. */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: site.name,
  description: site.description,
  url: site.url,
  image: new URL('/og.jpg', Astro.site ?? site.url).href,
  openingHoursSpecification: openingHoursSpecification(),
  /* Fourchette affichée par Google sous le nom du salon. Calculée sur la
     grille plutôt qu'écrite à la main : un tarif qui change la met à jour
     toute seule. */
  priceRange: (() => {
    const p = universes.flatMap((u) => u.categories.flatMap((c) => c.items.map((s) => s.price)));
    return `${Math.min(...p)} € – ${Math.max(...p)} €`;
  })(),
  makesOffer: universes.flatMap((u) =>
    u.categories.flatMap((c) =>
      c.items.map((s) => ({
        '@type': 'Offer',
        price: s.price,
        priceCurrency: 'EUR',
        itemOffered: { '@type': 'Service', name: s.name, category: u.label },
      })),
    ),
  ),
  aggregateRating: rating.show
    ? { '@type': 'AggregateRating', ratingValue: rating.value, reviewCount: rating.count }
    : undefined,
};
if (address.street && address.city && address.postalCode) {
  jsonLd.address = {
    '@type': 'PostalAddress',
    streetAddress: `${address.streetNumber} ${address.street}`,
    postalCode: address.postalCode,
    addressLocality: address.city,
    addressCountry: address.country,
  };
}
jsonLd.geo = { '@type': 'GeoCoordinates', latitude: geo.lat, longitude: geo.lon };
if (contact.phone) jsonLd.telephone = contact.phone;
if (contact.email) jsonLd.email = contact.email;
// sameAs relie l'établissement à ses comptes : Google s'en sert pour
// rattacher la fiche locale aux profils sociaux.
const reseaux = equipe.membres.map((p) => p.instagram).filter(Boolean);
if (reseaux.length) jsonLd.sameAs = reseaux;

const ogImage = new URL('/og.jpg', Astro.site ?? site.url).href;
const showBanner = pending.length > 0;
---

<!doctype html>
<!-- data-theme="light" : le site s'affiche en clair quel que soit le
     réglage du téléphone. Voir la note au-dessus de la palette sombre
     dans global.css. -->
<html lang="fr" data-theme="light" class={showBanner ? 'has-banner' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Couleur de la barre du navigateur sur Android : à tenir en phase
        avec `--ink` dans src/styles/theme.css. */}
    <meta name="theme-color" content="#1B1A19" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.tagline} à ${address.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* Les deux fontes du premier écran, préchargées : le reste suit
        au fil de la page. Aucune requête vers un domaine tiers — les
        polices sont servies depuis ce site, voir scripts/fetch-fonts.py. */}
    <link rel="preload" href="/fonts/cormorant-garamond-300-lat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-400-lat.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />


    <script is:inline>
      /* Apparitions au défilement.

         Le script pose `js-monte` sur <html> tout de suite, dans le
         <head>, et non après le chargement : sinon la page s'affiche une
         fraction de seconde puis se masque, ce qui se voit.

         Il ne la pose qu'après avoir vérifié ce dont il a besoin. Sans
         IntersectionObserver, ou si le visiteur demande moins de
         mouvement, rien n'est masqué et la page reste simplement
         lisible. `unobserve` rend l'apparition définitive : on ne
         redécore pas ce qui a déjà été lu. */
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-monte');

        function observer() {
          var vue = new IntersectionObserver(
            function (entrees) {
              /* Un décalage, mais seulement quand plusieurs blocs
                 franchissent la ligne ensemble — au doigt rapide, ou en
                 arrivant par une ancre. Au défilement posé, chaque bloc
                 arrive seul dans sa fournée et part donc sans retard :
                 le décalage se paie exactement là où il sert. */
              var arrives = entrees
                .filter(function (e) { return e.isIntersecting; })
                .sort(function (a, b) {
                  return a.boundingClientRect.top - b.boundingClientRect.top;
                });
              for (var i = 0; i < arrives.length; i++) {
                var bloc = arrives[i].target;
                if (i > 0) {
                  bloc.style.transitionDelay = Math.min(i, 6) * 0.07 + 's';
                }
                bloc.classList.add('vu');
                vue.unobserve(bloc);
              }
            },
            /* Le bas de la fenêtre est remonté d'un quart : le bloc
               s'anime une fois franchement à l'écran, pas au ras du
               bord où l'œil n'est pas. */
            { rootMargin: '0px 0px -25% 0px' }
          );
          var blocs = document.querySelectorAll('.monte');
          for (var i = 0; i < blocs.length; i++) vue.observe(blocs[i]);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observer);
        } else {
          observer();
        }
      })();
    </script>
  </head>

  <body>
    {
      showBanner && (
        <div class="preview">
          {gabarit ? (
            <>
              <span class="wide-only">
                Gabarit de démonstration — les textes, les photos et les tarifs sont des exemples.
              </span>
              <span class="narrow-only">Gabarit de démonstration</span>
            </>
          ) : (
            <>
              <span class="wide-only">
                Aperçu : {pending.slice(0, 3).join(', ')}
                {pending.length > 3 ? ' et autres données' : ''} à compléter.
              </span>
              <span class="narrow-only">Aperçu : {pending.length} données à compléter</span>
            </>
          )}
        </div>
      )
    }

    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <span id="haut" class="sr-only" />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Dock />

    <script>
      /* Menu mobile. Le panneau se glisse SOUS l'en-tête, qui reste
         visible : son bouton se change en croix et sert à refermer. C'est
         ce qui évite de redessiner le nom de l'institut dans le panneau —
         une copie de l'enseigne serait 1 px plus petite et 1,5 px plus
         basse, d'où un léger saut à l'ouverture.
         Le placement dans le calque supérieur de l'API Popover rendait ça
         impossible : il aurait masqué l'en-tête. On reprend donc Échap et
         le clic extérieur à la main, ce qui tient en quelques lignes. */
      const sheet = document.getElementById('menu-mobile');
      const burger = document.getElementById('burger');
      const topBar = document.getElementById('top');
      if (sheet && burger && topBar) {
        const dehors = [document.querySelector('main'), document.querySelector('footer')];
        const basculer = (ouvrir: boolean) => {
          sheet.hidden = !ouvrir;
          burger.setAttribute('aria-expanded', String(ouvrir));
          burger.setAttribute('aria-label', ouvrir ? 'Fermer le menu' : 'Ouvrir le menu');
          topBar.classList.toggle('menu-ouvert', ouvrir);
          document.body.style.overflow = ouvrir ? 'hidden' : '';
          // le reste de la page sort du parcours clavier et des lecteurs d'écran
          dehors.forEach((el) => el && (ouvrir ? el.setAttribute('inert', '') : el.removeAttribute('inert')));
        };

        /* `hidden` n'est pas tout à fait un booléen : il vaut aussi
           'until-found' pour un bloc replié que la recherche du navigateur
           peut rouvrir. On compare donc à `false` plutôt que de le lire
           comme un oui/non — sinon TypeScript le refuse, à juste titre. */
        burger.addEventListener('click', () => basculer(sheet.hidden !== false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !sheet.hidden) {
            basculer(false);
            burger.focus();
          }
        });
        sheet.addEventListener('click', (e) => {
          if (e.target instanceof Element && e.target.closest('a')) basculer(false);
        });
      }

      /* En-tête opaque dès qu'on quitte le hero. */
      const top = document.getElementById('top');
      const hero = document.querySelector('.hero');
      if (top && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([e]) => top.classList.toggle('solid', !e.isIntersecting),
          { rootMargin: '-88% 0px 0px 0px' },
        ).observe(hero);
      } else {
        top?.classList.add('solid');
      }
    </script>

    <script is:inline define:vars={{ hours }}>
      /* Ouvert / fermé — calculé chez le visiteur, sur l'heure de Paris.
         Le site étant statique, un calcul à la construction serait figé au
         jour de la mise en ligne. Pour un institut hors de France
         métropolitaine, changer le fuseau plus bas. */
      (function () {
        var GRID = {};
        hours.forEach(function (d) {
          GRID[d.day] = d.open === null ? null : [d.open, d.close];
        });
        var NAMES = {
          0: 'dimanche', 1: 'lundi', 2: 'mardi', 3: 'mercredi',
          4: 'jeudi', 5: 'vendredi', 6: 'samedi',
        };

        function paris() {
          var parts = new Intl.DateTimeFormat('fr-FR', {
            timeZone: 'Europe/Paris', weekday: 'short',
            hour: '2-digit', minute: '2-digit', hour12: false,
          }).formatToParts(new Date());
          var g = {};
          parts.forEach(function (p) { g[p.type] = p.value; });
          var map = { dim: 0, lun: 1, mar: 2, mer: 3, jeu: 4, ven: 5, sam: 6 };
          var key = (g.weekday || '').toLowerCase().slice(0, 3).replace('.', '');
          return {
            day: map[key] != null ? map[key] : new Date().getDay(),
            mins: parseInt(g.hour, 10) * 60 + parseInt(g.minute, 10),
          };
        }
        function hhmm(m) {
          return Math.floor(m / 60) + ' h ' + String(m % 60).padStart(2, '0');
        }

        var now = paris();
        var today = GRID[now.day];
        var open = !!today && now.mins >= today[0] && now.mins < today[1];

        var li = document.querySelector('#hours li[data-d="' + now.day + '"]');
        if (li) li.classList.add('today');

        var next = '';
        if (open) {
          next = 'Fermeture à ' + hhmm(today[1]);
        } else {
          for (var i = 0; i < 8; i++) {
            var d = (now.day + i) % 7;
            var g = GRID[d];
            if (!g) continue;
            if (i === 0 && now.mins >= g[0]) continue;
            next = i === 0 ? 'Ouverture à ' + hhmm(g[0])
                 : i === 1 ? 'Ouvre demain à ' + hhmm(g[0])
                 : 'Ouvre ' + NAMES[d] + ' à ' + hhmm(g[0]);
            break;
          }
        }

        function set(id, txt) {
          var el = document.getElementById(id);
          if (el) el.textContent = txt;
        }
        var live = document.getElementById('live');
        if (live) live.setAttribute('data-open', String(open));
        set('live-txt', open ? 'Ouvert' : 'Fermé');
        set('live-next', next);
        set('st-big', open ? 'C’est ouvert.' : 'C’est fermé.');
        set('st-next', next + '.');
        set('dock-txt', (open ? 'Ouvert · ' : 'Fermé · ') + next);
        set('sheet-status', (open ? 'Ouvert · ' : 'Fermé · ') + next);
        var sl = document.getElementById('sheet-live');
        if (sl) sl.setAttribute('data-open', String(open));
      })();
    </script>
  </body>
</html>
