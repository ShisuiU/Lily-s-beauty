---
import { bookHref, bookIsExternal, bookLabel, reservation } from '../data/site';

interface Props {
  /** Classes supplémentaires, p. ex. 'hide-sm' pour l'en-tête. */
  class?: string;
}
const { class: extra } = Astro.props;

/* Un lien qui ouvre un autre site doit le dire — sinon le visiteur
   découvre un nouvel onglet sans l'avoir demandé. */
const ariaLabel = bookIsExternal
  ? `Réserver${reservation.enseigne ? ' sur ' + reservation.enseigne : ''} (nouvel onglet)`
  : undefined;
---
<a
  class:list={['btn', extra]}
  href={bookHref}
  {...bookIsExternal ? { target: '_blank', rel: 'noopener', 'aria-label': ariaLabel } : {}}
>
  {bookLabel}
</a>
