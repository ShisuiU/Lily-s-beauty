---
import { equipe } from '../data/site';
import InstaLink from './InstaLink.astro';
---
{equipe.membres.length > 0 && (
  <div class="duo">
    <div class="monte">
      {/* `set:html` parce que la phrase d'accroche porte une mise en
          italique choisie dans site.ts : c'est du contenu écrit dans le
          dépôt, pas une saisie de visiteur. */}
      <p class="duo-lead" set:html={equipe.lead} />
      <p class="duo-body">{equipe.body}</p>
    </div>
    <ul class="who">
      {equipe.membres.map((p) => (
        <li class="monte">
          <b class="who-name">{p.name}</b>
          <span class="who-craft">{p.craft}</span>
          {p.instagram && <InstaLink url={p.instagram} name={p.name} />}
        </li>
      ))}
    </ul>
  </div>
)}
