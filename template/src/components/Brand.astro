---
import { site, brand, lienSection } from '../data/site';

/* L'enseigne de l'en-tête, en deux états.

   Sans logo (`brand.logo` à null), le nom s'écrit dans la fonte serif du
   site : c'est propre, ça se traduit, ça se redimensionne, et ça évite
   le rectangle gris qui traîne sur les maquettes en attente.

   Avec logo, le fichier est peint en MASQUE et non posé en <img> : il
   hérite alors de `currentColor`, donc blanc sur la photo du haut puis
   encre une fois la barre devenue opaque, transition comprise. Un PNG
   noir serait invisible en haut de page. Le fichier doit donc porter sa
   forme dans la transparence — PNG détouré ou SVG monochrome. */
const style = brand.logo
  ? `--logo:url('${brand.logo}');--logo-ratio:${brand.logoRatio};--logo-h:${brand.logoHeight}px`
  : undefined;
---
<a
  class:list={['brand', brand.logo ? 'brand-logo' : 'brand-mot']}
  href={lienSection('#haut')}
  style={style}
>
  <span class={brand.logo ? 'sr-only' : undefined}>{site.name}</span>
</a>
