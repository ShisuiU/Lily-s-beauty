---
import { site, pending, sections, lienSection, brand, bandeauApercu } from '../data/site';

/* Le logo du pied est une vraie image, pas un masque : posé sur le blanc
   de la page, il peut porter ses couleurs. Sans logo, le nom s'écrit
   dans la fonte serif — même parti pris que l'en-tête, et de loin le
   meilleur placeholder tant que la maison n'a pas de marque dessinée. */
const year = new Date().getFullYear();
---
<footer>
  <div class="shell">
    <div class="foot">
      {brand.logoCouleur ? (
        <img
          class="foot-logo monte"
          src={brand.logoCouleur}
          style={`aspect-ratio:${brand.logoCouleurRatio}`}
          alt={`${site.name}, ${site.tagline}`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <p class="foot-mot monte">{site.name}</p>
      )}
      <nav class="foot-links" aria-label="Navigation de pied de page">
        {sections.map((s) => <a href={lienSection(s.href)}>{s.label}</a>)}
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
      <p class="foot-note">
        © {year} {site.name}.
        {bandeauApercu && pending.length > 0 && (
          <> Site en cours de finalisation : {pending.join(', ')} restent à compléter.
            Tout est regroupé dans <code>src/data/site.ts</code>.</>
        )}
      </p>
    </div>
  </div>
</footer>
