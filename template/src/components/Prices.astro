---
import { universes, reservation, tarifsMajLe, tarifsIntro } from '../data/site';
import { formatDuration } from '../lib/hours';
import Equipe from './Equipe.astro';

const withCounts = universes.map((u) => ({
  ...u,
  count: u.categories.reduce((n, c) => n + c.items.length, 0),
}));
const total = withCounts.reduce((n, u) => n + u.count, 0);
---
<section id="tarifs">
  <div class="shell">
    <div class="sec-top monte">
      <hr class="rule" />
      <h2>Prestations et tarifs</h2>
    </div>

    <Equipe />

    <p class="tarifs-intro monte">{tarifsIntro.replace('{n}', String(total))}</p>

    <div class="universes">
      {withCounts.map((u) => (
        <details class="universe monte">
          {/* Trois niveaux, trois traitements. L'univers est un titre au
              serif, sur sa propre ligne repliable ; la catégorie est une
              carte blanche posée sur le fond crème ; la prestation est une
              ligne dans cette carte. Quand catégorie et prestation
              partagent la même graisse à deux dixièmes de point près, la
              liste se lit comme un seul bloc. */}
          <summary>
            <span class="u-head">
              <h3 class="u-name">{u.label}</h3>
              {u.by && <span class="u-by">avec {u.by}</span>}
            </span>
            <span class="u-count">{u.count}<i>prestations</i></span>
            <span class="u-mark" aria-hidden="true"></span>
          </summary>
          <div class="u-body">
            <p class="u-blurb">{u.blurb}</p>
            <div class="cats">
              {u.categories.map((c) => (
                <section class="cat">
                  <header class="cat-head">
                    <h4>{c.title}</h4>
                    <span class="cat-count">{c.items.length}</span>
                  </header>
                  <ul class="plist">
                    {c.items.map((s) => (
                      <li>
                        <span class="pname">{s.name}</span>
                        <span class="pcost">{s.price} €</span>
                        {s.note && <span class="pdetail">{s.note}</span>}
                        <span class="pdur">{formatDuration(s.minutes)}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>

    <p class="pnote">
      Tarifs mis à jour le {tarifsMajLe}.
      {reservation.url && reservation.enseigne && (
        <>
          {' '}En cas d'écart,{' '}
          <a href={reservation.url} target="_blank" rel="noopener">la fiche {reservation.enseigne}</a>{' '}
          fait foi : c'est elle qui porte l'agenda et les tarifs à jour.
        </>
      )}
    </p>
  </div>
</section>
