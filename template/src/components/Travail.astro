---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { travail } from '../data/site';

const fichiers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/travail-*.jpg',
  { eager: true },
);

/* Taille d'ouverture sur ordinateur, et d'où vient le nombre.

   Les originaux livrés ici font 1 290 px de côté : c'est ce que rend
   Instagram, d'où vient la plupart des photos d'une enseigne, et on ne
   peut pas inventer de pixels au-delà. Affichée à 720 px, la photo est
   donc réduite sur un écran ordinaire et agrandie de 12 % seulement sur
   un écran à double densité (1 440 demandés contre 1 290 disponibles).
   Douze pour cent ne se voient pas ; c'est ce qui fixe le 720. Des
   originaux plus grands permettraient d'ouvrir plus grand, pas
   l'inverse : relever ce nombre avec la taille réelle des fichiers. */
const OUVERTURE = 1290;

const groupes = await Promise.all(
  travail.groupes.map(async (g) => ({
    ...g,
    photos: await Promise.all(
      g.photos.map(async (p) => {
        const trouve = fichiers[`../assets/${p.fichier}`];
        if (!trouve) throw new Error(`travail : src/assets/${p.fichier} est introuvable`);
        const grand = await getImage({
          src: trouve.default,
          format: 'avif',
          quality: 72,
          width: OUVERTURE,
        });
        return { src: trouve.default, alt: p.alt, grand: grand.src };
      }),
    ),
  })),
);
---
<section id="travail">
  <div class="shell">
    <div class="sec-top monte">
      <hr class="rule" />
      <h2>{travail.titre}</h2>
      <p>{travail.lead}</p>
    </div>

    {groupes.map((g) => (
      <div class="trav-groupe monte">
        <header class="trav-head">
          <h3>{g.titre}</h3>
          {g.by && <span class="trav-by">avec {g.by}</span>}
        </header>
        {/* Chaque photo est dans un vrai bouton, pas dans une image qu'on
            écoute : c'est ce qui la rend atteignable au clavier et
            annoncée comme une commande. `data-grand` porte l'adresse de
            la version d'ouverture, calculée à la construction — le script
            n'a donc aucune URL à deviner. */}
        <ul class="trav-grille" data-zoom>
          {g.photos.map((p) => (
            <li>
              <button type="button" class="trav-zoom" data-grand={p.grand} data-alt={p.alt}>
                {/* `width` explicite : sans lui, l'adresse de repli du
                    `<img>` pointe sur la largeur d'origine, soit 1 290 px
                    — une vignette de 290 px qui embarque un fichier de
                    150 Ko pour les rares navigateurs sans `srcset`, et
                    une seconde variante 1 290 px construite pour rien à
                    côté de celle de la vue agrandie. */}
                <Image
                  src={p.src}
                  alt={p.alt}
                  width={860}
                  widths={[280, 440, 620, 860]}
                  sizes="(max-width: 759px) 45vw, 22vw"
                  format="avif"
                  quality={64}
                  loading="lazy"
                />
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

{/* Un seul `<dialog>` pour toute la page, rempli au clic. Natif, et pas
    une division qu'on empile : il prend le focus, le retient, se ferme à
    Échap et s'affiche au-dessus de tout sans qu'on ait à inventer un
    z-index. */}
<dialog class="trav-vue" data-vue aria-label="Photo agrandie">
  <img alt="" />
  <button type="button" class="trav-fermer" data-fermer aria-label="Fermer la photo">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />
    </svg>
  </button>
</dialog>

<script is:inline>
  /* Deux gestes pour une même intention, selon la place disponible.

     Sur téléphone, la grille fait deux colonnes sur deux lignes, donc un
     carré : la photo s'ouvre sur place et occupe exactement la place des
     quatre. Sur ordinateur elles sont sur une seule ligne, il n'y a plus
     de carré à remplir, et la photo s'ouvre dans une vue par-dessus la
     page.

     Dans les deux cas l'animation est un FLIP : on relève la position de
     départ, on applique l'état d'arrivée, on relève la position finale,
     et on rejoue l'écart à l'envers. C'est le seul moyen d'animer un
     passage en `position: absolute` ou l'ouverture d'un `<dialog>`, qui
     ne se transitionnent ni l'un ni l'autre. */
  (function () {
    var grilles = document.querySelectorAll('[data-zoom]');
    var vue = document.querySelector('[data-vue]');
    if (!grilles.length || !document.body.animate) return;

    var DUREE = 340;
    var COURBE = 'cubic-bezier(0.22, 0.9, 0.28, 1)';
    var etroit = window.matchMedia('(max-width: 759px)');
    var douceur = window.matchMedia('(prefers-reduced-motion: reduce)');
    var venuDe = null;
    var attendue = null;

    function glisse(el, avant) {
      if (douceur.matches) return;
      var apres = el.getBoundingClientRect();
      if (!apres.width || !avant.width) return;
      el.animate(
        [
          {
            transformOrigin: 'top left',
            transform:
              'translate(' + (avant.left - apres.left) + 'px, ' + (avant.top - apres.top) + 'px)' +
              ' scale(' + avant.width / apres.width + ', ' + avant.height / apres.height + ')',
          },
          { transformOrigin: 'top left', transform: 'none' },
        ],
        { duration: DUREE, easing: COURBE },
      );
    }

    /* ── téléphone : sur place ──
       `sizes` décrit la vignette, pas la photo ouverte : la décrire à sa
       taille d'ouverture faisait télécharger, pour chacune des huit, une
       variante deux fois trop grande — 421 Ko au lieu de 150 — que la
       plupart des visiteurs n'agrandiront jamais.

       On passe donc à la version d'ouverture au moment de l'ouverture,
       comme sur ordinateur. La photo affichée étant déjà la bonne, cet
       échange ne fait que la préciser : il n'y a rien de faux à voir
       entre-temps. `srcset` et `sizes` doivent partir avec, sinon ils
       l'emportent sur `src` et l'échange n'a pas lieu. */
    function haussePhoto(li) {
      var bouton = li.querySelector('.trav-zoom');
      var img = li.querySelector('img');
      var grand = bouton && bouton.getAttribute('data-grand');
      if (!grand || img.getAttribute('data-haussee') === grand) return;
      var haute = new Image();
      haute.onload = function () {
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.src = grand;
        img.setAttribute('data-haussee', grand);
      };
      haute.src = grand;
    }

    function bascule(li, ouvrir) {
      var grille = li.parentElement;
      var avant = li.getBoundingClientRect();
      li.classList.toggle('ouvert', ouvrir);
      grille.classList.toggle('zoome', ouvrir);
      li.querySelector('.trav-zoom').setAttribute('aria-expanded', ouvrir ? 'true' : 'false');
      if (ouvrir) haussePhoto(li);
      glisse(li, avant);
    }

    function ferme(grille) {
      var ouvert = grille.querySelector('li.ouvert');
      if (ouvert) bascule(ouvert, false);
    }

    /* ── ordinateur : par-dessus la page ──
       La vue est une seule et même image, remplie à chaque ouverture. Lui
       donner directement l'adresse de la grande version affichait la
       photo **précédente** le temps que la nouvelle arrive : un
       navigateur garde ce qu'il a peint tant qu'il n'a pas mieux.

       On part donc de la vignette, déjà décodée et en cache : la bonne
       photo est là immédiatement, simplement plus douce. La grande prend
       sa place dès qu'elle est prête. `attendue` évite qu'une grande
       version arrivée en retard ne s'installe par-dessus une autre photo
       ouverte entre-temps. */
    function ouvreVue(bouton) {
      if (!vue || !vue.showModal) return;
      var img = vue.querySelector('img');
      var vignette = bouton.querySelector('img');
      var grand = bouton.getAttribute('data-grand');
      var depart = bouton.getBoundingClientRect();

      img.src = (vignette && (vignette.currentSrc || vignette.src)) || grand;
      img.alt = bouton.getAttribute('data-alt') || '';
      attendue = grand;
      venuDe = bouton;
      vue.showModal();
      glisse(img, depart);

      var haute = new Image();
      haute.onload = function () {
        if (vue.open && attendue === grand) img.src = grand;
      };
      haute.src = grand;
    }

    grilles.forEach(function (grille) {
      grille.addEventListener('click', function (e) {
        var bouton = e.target.closest('.trav-zoom');
        if (!bouton) return;
        if (etroit.matches) {
          var li = bouton.parentElement;
          var etait = li.classList.contains('ouvert');
          ferme(grille);
          if (!etait) bascule(li, true);
        } else {
          ouvreVue(bouton);
        }
      });
    });

    if (vue) {
      /* Un clic à côté de la photo ferme : la cible de l'événement est
         alors le `<dialog>` lui-même, jamais l'image ni le bouton. */
      vue.addEventListener('click', function (e) {
        if (e.target === vue || e.target.closest('[data-fermer]')) vue.close();
      });
      vue.addEventListener('close', function () {
        if (venuDe) venuDe.focus();
        venuDe = null;
        attendue = null;
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') grilles.forEach(ferme);
    });

    /* Le rôle du bouton n'est pas le même des deux côtés : il déplie sur
       téléphone, il ouvre une vue sur ordinateur. On le dit correctement
       plutôt que de laisser un `aria-expanded` mentir à moitié. */
    function annonce() {
      var surPlace = etroit.matches;
      document.querySelectorAll('.trav-zoom').forEach(function (b) {
        if (surPlace) {
          b.removeAttribute('aria-haspopup');
          if (!b.hasAttribute('aria-expanded')) b.setAttribute('aria-expanded', 'false');
        } else {
          b.removeAttribute('aria-expanded');
          b.setAttribute('aria-haspopup', 'dialog');
        }
      });
    }
    annonce();
    etroit.addEventListener('change', function (e) {
      if (!e.matches) grilles.forEach(ferme);
      else if (vue && vue.open) vue.close();
      annonce();
    });
  })();
</script>
