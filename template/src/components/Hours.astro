---
import { hours, hoursConfirmed, horaires } from '../data/site';
import { formatRange } from '../lib/hours';
import Todo from './Todo.astro';
---
<section id="horaires">
  <div class="shell">
    <div class="sec-top monte">
      <hr class="rule" />
      <h2>{horaires.titre}</h2>
    </div>
    <div class="hours-wrap">
      <ul class="hours" id="hours">
        {hours.map((d) => (
          <li class="monte" data-d={d.day}>
            <span class="d">{d.label}</span>
            <span class={d.open === null ? 'h shut' : 'h'}>{formatRange(d)}</span>
          </li>
        ))}
      </ul>
      <div class="status monte">
        <span class="eyebrow">{horaires.surtitre}</span>
        <p class="big" id="st-big">{horaires.attente}</p>
        <p><span id="st-next"></span>
          {!hoursConfirmed && <> Ces horaires sont <Todo label="à confirmer" />.</>}
        </p>
      </div>
    </div>
  </div>
</section>
